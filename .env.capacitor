VITE_API_BASE_URL=https://flow.knexura.online/api
# The App Store product IDs are NOT set here any more: they are served at runtime by the
# backend with the plan list (see APPLE_IAP_PRODUCT_ID_* in moneymanagerapi's billing
# config). Inlining them at build time meant a CI checkout without this file silently
# shipped an iOS paywall with no purchasable product.
