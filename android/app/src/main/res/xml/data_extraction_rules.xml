<?xml version="1.0" encoding="utf-8"?>
<!-- La sesión (tokens en el almacenamiento del WebView) y los datos financieros no deben
     copiarse a Google Drive ni pasarse a otro dispositivo al migrar (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
